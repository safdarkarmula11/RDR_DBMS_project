# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nimbushost
DB_USER=deku
DB_PASSWORD=1234

# Role-specific Database Accounts (optional, defaults to DB_USER / DB_PASSWORD)
DB_ADMIN_USER=deku
DB_ADMIN_PASSWORD=1234
DB_SUPPORT_USER=deku
DB_SUPPORT_PASSWORD=1234
DB_BILLING_USER=deku
DB_BILLING_PASSWORD=1234
DB_CUSTOMER_USER=deku
DB_CUSTOMER_PASSWORD=1234

# Security and JWT
JWT_SECRET=nimbushost_production_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
